# REQUIRED to load the gallery and other database-backed pages.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# OPTIONAL for the dev server; required by Prisma commands that use directUrl.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# REQUIRED for Clerk UI and server-side authenticated account features.
# Use development keys from your own Clerk development instance for auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_development_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_development_key

# OPTIONAL; Clerk's sign-in and sign-up routes used by server middleware.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OPTIONAL; redirects users after Clerk sign-in or sign-up. Defaults are set by Clerk.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# OPTIONAL; controls canonical URLs and metadata. Defaults to the hosted Screeny URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL; required only when importing or refreshing app assets in Cloudflare R2.
R2_ACCOUNT_ID=replace_with_r2_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=replace_with_r2_bucket_name

# OPTIONAL; used by the same-origin image route and by the R2 import scripts.
R2_PUBLIC_URL=https://assets.example.invalid

# OPTIONAL; enables email notifications for app submissions.
RESEND_API_KEY=re_replace_with_resend_api_key

# OPTIONAL; sender address for submission emails. Defaults to Resend's onboarding sender.
SUBMISSIONS_FROM_EMAIL=Screeny <onboarding@resend.dev>
